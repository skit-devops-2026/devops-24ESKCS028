{
  "title": "Krishi Clinic Application Dashboard",
  "description": "Monitors HTTP traffic, process uptime, and application health for Krishi Clinic",
  "panels": [
    {
      "id": 1,
      "title": "Application Status",
      "type": "stat",
      "targets": [
        {
          "expr": "app_status",
          "legendFormat": "Status"
        }
      ]
    },
    {
      "id": 2,
      "title": "Total HTTP Requests",
      "type": "graph",
      "targets": [
        {
          "expr": "http_requests_total",
          "legendFormat": "Requests"
        }
      ]
    },
    {
      "id": 3,
      "title": "Process Uptime (seconds)",
      "type": "stat",
      "targets": [
        {
          "expr": "process_uptime_seconds",
          "legendFormat": "Uptime"
        }
      ]
    }
  ]
}
